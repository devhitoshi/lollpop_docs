# macOS がフォルダごとに作るメタデータ。リポジトリには不要。
.DS_Store

# 解析用に購入した音源。私的複製の範囲で手元に置くものなので、リポジトリでは配布しない。
# 解析して得た数値（songs/analysis/ 配下の md と song_features.csv）だけをコミットする。
/audio/*
!/audio/README.md
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus

# twitterapi.io の APIキー。.claude/skills/x-account-fetch のスクリプトが読む。
# キーは絶対にコミットしない。
.env

# X から取得した投稿データ。他人の著作物なので手元だけに置き、
# ここから起こした記事本文だけをコミットする。
work/probe_raw.jsonl
work/*.jsonl
work/**/*.jsonl
work/x_fetch/

# Python の中間生成物
__pycache__/
*.pyc

# セトリ白書の図表の確認用出力（render_charts.py の既定の出力先）。白書に反映するときは articles/セトリ白書/img へ
work/charts/

# ダウンロードした画像・動画（許諾済みでも他人の著作物。リポジトリには入れない）
work/x_media/

# 書き出した動画。台本はリポジトリに置くが、動画そのものは Google Drive に置いて URL で渡す。
# どの台本から何が出てどこにあるかは strategy/video/台本/納品メモ.md が索引になる。
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.gif
# レンダリングの中間生成物・書き出し先
work/video/
work/render/

# OpenACP（Discord ブリッジ）の設定。config.json に Discord の Bot トークンが平文で入る。
# 既定の置き場はリポジトリ外（C:\Users\kawad\work\.openacp\）だが、
# workspace を取り違えてここに作られたときのための保険。
.openacp/

# Claude Code のワークツリー。Discord のスレッドごとに作業ディレクトリを分けるために作られる。
# 中身は同じリポジトリの別チェックアウトなので、コミット対象にしない。
.claude/worktrees/

# posfie のログインセッション（X OAuth を通した cookie）。認証情報なのでコミットしない。
# .claude/skills/posfie-summary/scripts/posfie_post.py --login が作る。
work/.posfie_state.json

# posfie の素材データ（build_material.py の中間出力）。他人の投稿の原文を含むので
# work/x_fetch/ と同じ扱いにする。選んだ結果と引用だけを articles/posfie/ にコミットする。
work/posfie/
