# macOS がフォルダごとに作るメタデータ。リポジトリには不要。
.DS_Store

# 解析用に購入した音源。私的複製の範囲で手元に置くものなので、リポジトリでは配布しない。
# 解析して得た数値（songs/analysis/ 配下の md と song_features.csv）だけをコミットする。
/audio/*
!/audio/README.md
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus

# twitterapi.io の APIキー。検証用スクリプト work/x_ugc_probe.py が読む。
# キーは絶対にコミットしない。
.env

# 検証で取得した X の生JSON。他人の投稿なので手元だけに置く。
work/probe_raw.jsonl
work/*.jsonl
